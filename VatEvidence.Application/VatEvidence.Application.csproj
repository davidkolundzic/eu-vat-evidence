<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <EnableFileNesting>true</EnableFileNesting>
    <FileNestingRules>
      <FileNestingRule Update="%(DependentUpon).cs" Pattern="^I(?&lt;base&gt;.+)\.cs$" DependsOn="${base}.cs" />
    </FileNestingRules>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="Stripe.net" Version="50.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VatEvidence.Domain\VatEvidence.Domain.csproj" />
  </ItemGroup>

</Project>
