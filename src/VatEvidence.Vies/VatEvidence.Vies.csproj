<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    
        <LangVersion>latest</LangVersion>
 
    <PackageId>VatEvidence.Vies</PackageId>
    <Version>0.1.0</Version>
    <Authors>your-name</Authors>
    <Description>EU VIES VAT active-status verification client. Zero external dependencies.</Description>
    <PackageTags>vat;vies;eu;validation;tax</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/you/eu-vat-evidence</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>

  </PropertyGroup>

</Project>
